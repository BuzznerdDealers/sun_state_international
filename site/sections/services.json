{
  "version": 2,
  "id": "services",
  "name": "Services list",
  "props": [
    {
      "key": "items",
      "type": "list",
      "label": "Rows",
      "fields": [
        { "key": "num", "type": "text", "label": "Number" },
        { "key": "title", "type": "text", "label": "Title" },
        { "key": "desc", "type": "textarea", "label": "Description" },
        { "key": "ctaLabel", "type": "text", "label": "CTA label" },
        { "key": "ctaUrl", "type": "url", "label": "CTA link" }
      ]
    }
  ],
  "nodes": [
    {
      "id": "services-outer-row",
      "type": "row",
      "props": { "gap": 0 },
      "children": [
        {
          "id": "services-outer-col",
          "type": "column",
          "props": { "span": 12 },
          "children": [
            {
              "id": "service-row",
              "type": "row",
              "props": { "gap": 4, "stackOn": "mobile", "align": "center", "repeat": "items" },
              "children": [
                { "id": "service-row-num", "type": "column", "props": { "span": 1 }, "children": [
                  { "id": "service-row-num-text", "type": "text", "props": { "text": "{{num}}" } }
                ] },
                { "id": "service-row-body", "type": "column", "props": { "span": 8 }, "children": [
                  { "id": "service-row-title", "type": "heading", "props": { "text": "{{title}}", "headingLevel": 3 } },
                  { "id": "service-row-desc", "type": "text", "props": { "text": "{{desc}}" } }
                ] },
                { "id": "service-row-cta", "type": "column", "props": { "span": 3, "align": "end" }, "children": [
                  { "id": "service-row-cta-buttons", "type": "buttons", "props": { "items": [{ "label": "{{ctaLabel}}", "url": "{{ctaUrl}}", "style": "link" }], "align": "left" } }
                ] }
              ]
            }
          ]
        }
      ]
    }
  ],
  "css": "[data-bz-node^=\"service-row\"]{border-top:1px solid var(--line);padding:32px 0;} [data-bz-node^=\"service-row-num-text\"] p{font-family:var(--font-heading);font-weight:800;font-size:20px;color:var(--muted);margin:0;} [data-bz-node^=\"service-row-title\"] h3{font-family:var(--font-heading);font-weight:700;font-size:20px;margin-bottom:4px;} [data-bz-node^=\"service-row-desc\"] p{font-size:15px;color:var(--muted);}"
}
